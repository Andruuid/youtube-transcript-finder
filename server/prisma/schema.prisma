generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id               Int      @id @default(autoincrement())
  youtubeChannelId String   @unique
  title            String
  handle           String?
  /** YouTube's low-quota uploads playlist used to page channel videos. */
  uploadsPlaylistId String?
  /** Original YouTube thumbnail URL (used to refresh stored image). */
  thumbnailUrl     String?
  thumbnailData    Bytes?
  thumbnailMimeType String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  videos           Video[]
  politicsMembership PoliticsChannel?
  cryptoAnalyses CryptoAnalysis[]
  cryptoCalibrations CryptoCalibration[]
  cryptoSettings CryptoChannelSettings?

  @@index([title])
}

model PoliticsChannel {
  id        Int      @id @default(autoincrement())
  channelId Int      @unique
  /** User-assigned corpus side. Validated as "left" or "right" by the API. */
  side      String
  /** Zero-based display order within a side. */
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([side, position])
}

model Video {
  id                Int      @id @default(autoincrement())
  youtubeVideoId    String   @unique
  channelId         Int
  title             String
  description       String
  publishedAt       DateTime
  thumbnailUrl      String?
  /** Video length from YouTube contentDetails.duration, in seconds. */
  durationSeconds   Int?
  hasTranscript     Boolean  @default(false)
  transcriptText    String?
  transcriptFetchedAt DateTime?
  /** OpenRouter short summary text */
  sumShort          String?
  sumShortModel     String?
  /** OpenRouter long summary text */
  sumLong           String?
  sumLongModel      String?
  /** Full structured summary JSON imported from external tool */
  structuredSummaryJson         String?
  /** Denormalized from structured summary product_name */
  productName                   String?
  /** Denormalized from structured summary marketing.growth_type */
  niche                         String?
  structuredSummaryImportedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  cryptoAnalyses    CryptoAnalysis[]

  @@index([channelId, publishedAt(sort: Desc)])
  @@index([hasTranscript])
}

model Idea {
  id             Int      @id @default(autoincrement())
  channelTitle   String
  videoTitle     String
  stars          Int
  effort         String?
  comment        String?
  youtubeVideoId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model CryptoAnalysis {
  id             Int      @id @default(autoincrement())
  videoId        Int
  channelId      Int
  transcriptHash String
  model          String
  promptVersion  String
  relevant       Boolean
  resultJson     String
  createdAt      DateTime @default(now())
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([videoId, transcriptHash, model, promptVersion])
  @@index([channelId, createdAt])
}

model CryptoCalibration {
  id            Int      @id @default(autoincrement())
  channelId     Int
  version       Int
  coverageHash  String
  profileJson   String
  createdAt     DateTime @default(now())
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, version])
}

model CryptoChannelSettings {
  channelId     Int      @id
  overridesJson String   @default("{}")
  updatedAt     DateTime @updatedAt
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model CryptoJob {
  id             String   @id @default(cuid())
  kind           String
  status         String   @default("queued")
  paramsJson     String
  checkpointJson String   @default("{}")
  message        String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          CryptoJobItem[]

  @@index([status, createdAt])
}

model CryptoJobItem {
  id             Int      @id @default(autoincrement())
  jobId          String
  youtubeVideoId String
  status         String   @default("pending")
  attempts       Int      @default(0)
  error          String?
  updatedAt      DateTime @updatedAt
  job            CryptoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, youtubeVideoId])
}

model CryptoCandle {
  id        Int      @id @default(autoincrement())
  asset     String
  day       DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   @default("coinbase")
  fetchedAt DateTime @default(now())

  @@unique([asset, day])
}

model CryptoPriceWindow {
  id        Int      @id @default(autoincrement())
  asset     String
  start     DateTime
  end       DateTime
  fetchedAt DateTime @default(now())

  @@unique([asset, start, end])
}
