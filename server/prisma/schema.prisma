generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id               Int      @id @default(autoincrement())
  youtubeChannelId String   @unique
  title            String
  handle           String?
  /** Original YouTube thumbnail URL (used to refresh stored image). */
  thumbnailUrl     String?
  thumbnailData    Bytes?
  thumbnailMimeType String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  videos           Video[]

  @@index([title])
}

model Video {
  id                Int      @id @default(autoincrement())
  youtubeVideoId    String   @unique
  channelId         Int
  title             String
  description       String
  publishedAt       DateTime
  thumbnailUrl      String?
  /** Video length from YouTube contentDetails.duration, in seconds. */
  durationSeconds   Int?
  hasTranscript     Boolean  @default(false)
  transcriptText    String?
  transcriptFetchedAt DateTime?
  /** OpenRouter short summary text */
  sumShort          String?
  sumShortModel     String?
  /** OpenRouter long summary text */
  sumLong           String?
  sumLongModel      String?
  /** Full structured summary JSON imported from external tool */
  structuredSummaryJson         String?
  /** Denormalized from structured summary product_name */
  productName                   String?
  /** Denormalized from structured summary marketing.growth_type */
  niche                         String?
  structuredSummaryImportedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, publishedAt(sort: Desc)])
  @@index([hasTranscript])
}

model Idea {
  id             Int      @id @default(autoincrement())
  channelTitle   String
  videoTitle     String
  stars          Int
  comment        String?
  youtubeVideoId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}
