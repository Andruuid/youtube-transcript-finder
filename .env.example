# Backend (channel import/sync) — required in server/.env
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional. When YouTube asks to sign in, export Netscape cookies for youtube.com
# ONLY from one signed-in browser tab to server/youtube.cookies.txt (gitignored).
# The file is reloaded for every download; replacing it needs no server restart.
# Alternatively set this Cookie header (takes precedence; requires restart).
# YOUTUBE_COOKIE=
DATABASE_URL="file:./server/prisma/transcripts.dev.db"

# Optional: require a shared password for /api and /transcript (leave unset for open local dev)
# ACCESS_PASSWORD=choose-a-long-random-password

# Frontend (video search in the main tab) — optional .env in project root
REACT_APP_YOUTUBE_API_KEY=your_youtube_data_api_key
REACT_APP_TRANSCRIPT_API_URL=

# Transcript summarization (read by the transcript server — set in server/.env or the shell)
# OPENROUTER_API_KEY=
# Crypto uses this same key with the pinned openai/gpt-6-luna model (no fallbacks).
# SUMMARIZERMODEL_NAME=openai/gpt-4o-mini
# Optional: comma-separated OpenRouter slugs to try if the primary hits 429 / rate limits / overload
# SUMMARIZERMODEL_FALLBACKS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-4o-mini
# SUMUPSMALL_PROMPT=
# SUMUPLONG_PROMPT=
# Optional OpenRouter rankings headers:
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_TITLE=
